# Copy to .env.test — `pnpm test` reads it via tests/setup/env.ts.
#
#   cp .env.test.example .env.test
#
# DATABASE_URL must point at the disposable Postgres on 5434 from
# docker-compose.test.yml, never at the development database on 5432:
# tests/helpers/db.ts TRUNCATEs every table between tests.
DATABASE_URL=postgres://babellm:babellm@localhost:5434/babellm_test

# THESE THREE VALUES ARE PUBLIC — they are checked into this repo so a fresh
# checkout can run the suite with no setup. They only ever protect a database
# that dies with its container. Never reuse them anywhere real.
ENCRYPTION_KEY=fadbe6aca386ca6de269735dfe34ca7e6c02a93ed599bdaa690a5677a4260d88
ADMIN_PASSWORD=devpassword
SESSION_SECRET=b6274d1f132cc3d619d2247b06bd9f78c1a9fa49d5652df1397f9381d1c83e2f

# The disposable Redis from docker-compose.test.yml. Deliberately NOT named
# REDIS_URL: that is what getUsageStore() reads, so setting it here would put
# the entire suite on the Redis driver and make every test need a container.
# Only tests/lib/usage/redis.test.ts reads this, and it skips without it.
TEST_REDIS_URL=redis://localhost:6380
