{
  "name": "babellm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "dev:test-db": "DATABASE_URL=postgres://babellm:babellm@localhost:5434/babellm_dev NEXT_DIST_DIR=.next-test sh -c 'node scripts/migrate.mjs && next dev --port 3001'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:deploy": "node scripts/migrate.mjs",
    "seed:refresh": "node scripts/refresh-seed.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@google/genai": "2.17.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "openai": "7.4.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "4.17.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.15.3",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
