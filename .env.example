# Postgres connection string
DATABASE_URL=postgres://babellm:babellm@localhost:5432/babellm

# 32-byte key, hex encoded. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Dashboard password (single shared admin password)
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. openssl rand -hex 32
SESSION_SECRET=

# Optional. Where per-key rpm, tpm, and spend counters live. Unset means an
# in-process map: counters reset on restart and each instance enforces limits
# on its own. Set it to share counters across instances.
# REDIS_URL=redis://localhost:6379
